    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gtfs-realtime-bindings": "^3.0.0",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^12.23.24",
