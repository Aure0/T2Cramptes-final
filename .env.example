# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Map tiles use 100% free, open-source MapLibre GL JS + OpenFreeMap vector tiles (no API key required).

# T2C_GTFS_RT_ALERTS_URL: Optional dedicated GTFS-RT ServiceAlerts protobuf feed URL.
T2C_GTFS_RT_ALERTS_URL=""

# Optional GitHub Pages / Static / Android Deployment settings:
# VITE_STATIC_MODE="true"
# VITE_BASE_PATH="./"
# VITE_API_BASE_URL=""
# VITE_ALERTS_PROXY_URL=""   # Optional Cloudflare Worker CORS proxy URL (see cloudflare-worker/)
# VITE_GITHUB_REPO="owner/repo"
# VITE_ANDROID_APK_URL=""
# VITE_APP_BUILD_NUMBER="1"
# VITE_APP_COMMIT_SHA=""
# CORS_ORIGIN="*"
